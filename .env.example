# ──────────────────────────────────────────────────────────────────────────────
# Steam Skin Scraper — environment configuration
# Copy this file to .env and fill in your API keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── API keys ──────────────────────────────────────────────────────────────────

# Pricempire  → https://pricempire.com/api  (free & paid tiers)
# Uses v3 endpoint (/v3/items/prices). For v4 paid endpoint swap the URL in
# sources/pricempire.py to /v4/paid/items/prices.
PRICEMPIRE_API_TOKEN=

# SteamWebAPI → https://www.steamwebapi.com  (free & paid tiers)
STEAMWEBAPI_KEY=

# cs2.sh      → https://cs2.sh  (3-day free developer key available on signup)
CS2SH_API_KEY=

# ── App settings ──────────────────────────────────────────────────────────────
ITEMS_FILE=items.txt
DB_PATH=data/scraper.db
TOP_N_ITEMS=20

# Steam sell commission (13% gross = ~11.5% net; adjust per item type if needed)
STEAM_SELL_FEE=0.13

# ── Rate limiting (seconds between requests per source) ───────────────────────
PRICEMPIRE_MIN_DELAY=1.0
PRICEMPIRE_CACHE_TTL=300

STEAMWEBAPI_MIN_DELAY=1.0
STEAMWEBAPI_CACHE_TTL=300

CS2SH_MIN_DELAY=1.0
CS2SH_CACHE_TTL=300

# ── Retry settings ────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY=2.0

# ── Collect daemon ────────────────────────────────────────────────────────────
# How often to collect in daemon mode (python main.py collect)
COLLECT_INTERVAL_MINUTES=30
# Delete raw JSON files older than this many days (set 0 to disable cleanup)
RAW_RETENTION_DAYS=14

# ── Items universe ────────────────────────────────────────────────────────────
# ITEMS_MODE=file    — use items.txt whitelist (default)
# ITEMS_MODE=universe — fetch full CS2 item list from Pricempire or cs2.sh, filter by price
ITEMS_MODE=file
MIN_PRICE_USD=1.0
MAX_PRICE_USD=500.0
UNIVERSE_MAX_ITEMS=2000

# ── Liquidity filters (Stage 3) ───────────────────────────────────────────────
# Items that fail any hard filter are excluded from scoring entirely.
# The funnel summary is printed before each top list.

# Minimum 24h sales volume across any source (hard filter)
MIN_VOLUME_24H=10

# Minimum number of active Steam buy orders (hard filter; ignored if data absent → qty_unknown flag)
MIN_BUY_ORDER_QTY=3

# Minimum number of independent sources that must have data for the item
MIN_SOURCES=2

# Maximum allowed price divergence between sources, in % of the lowest price
# e.g. 15.0 means sources must agree within ±15%
MAX_SOURCE_DIVERGENCE_PCT=15.0

# ── Telegram bot (Stage 5) ───────────────────────────────────────────────────
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated chat IDs that are allowed to use the bot (e.g. 123456,789012)
# Leave empty to allow everyone (not recommended for public bots)
TELEGRAM_ALLOWED_CHAT_IDS=

# Notification anti-spam: min minutes between two notifications for the same item per chat
NOTIFY_COOLDOWN_MINUTES=360

# Max notifications sent per collect pass per chat
NOTIFY_MAX_PER_RUN=5

# Number of items per page in /top
BOT_TOP_N=5

# ── Historical analytics (Stage 4) ───────────────────────────────────────────
# Minimum days of snapshot history before stability analysis activates per item
STABILITY_MIN_DAYS=7
# Bonus score points added when an item is classified as stable
STABILITY_WEIGHT=10
# backtest command: how many days ahead to measure price outcome
BACKTEST_HORIZON_DAYS=7
