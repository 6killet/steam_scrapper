# ──────────────────────────────────────────────────────────────────────────────
# Steam Skin Scraper — environment configuration
# Copy this file to .env and fill in your API keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── API keys ──────────────────────────────────────────────────────────────────

# Pricempire  → https://pricempire.com/api  (free & paid tiers)
# Uses v3 endpoint (/v3/items/prices). For v4 paid endpoint swap the URL in
# sources/pricempire.py to /v4/paid/items/prices.
PRICEMPIRE_API_TOKEN=your_pricempire_token_here

# SteamWebAPI → https://www.steamwebapi.com  (free & paid tiers)
STEAMWEBAPI_KEY=your_steamwebapi_key_here

# cs2.sh      → https://cs2.sh  (3-day free developer key available on signup)
CS2SH_API_KEY=your_cs2sh_key_here

# ── App settings ──────────────────────────────────────────────────────────────
ITEMS_FILE=items.txt
DB_PATH=data/scraper.db
TOP_N_ITEMS=20

# Steam sell commission (13% gross = ~11.5% net; adjust per item type if needed)
STEAM_SELL_FEE=0.13

# ── Rate limiting (seconds between requests per source) ───────────────────────
PRICEMPIRE_MIN_DELAY=1.0
PRICEMPIRE_CACHE_TTL=300

STEAMWEBAPI_MIN_DELAY=1.0
STEAMWEBAPI_CACHE_TTL=300

CS2SH_MIN_DELAY=1.0
CS2SH_CACHE_TTL=300

# ── Retry settings ────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY=2.0
